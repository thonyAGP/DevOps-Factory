{
  "$comment": "Flux surveilles par scripts/silence-watchdog.ts (chantier .chantier/2026-10-08-watchdog-silence). Etat persistant : data/silence-watchdog-state.json. https.auth : secret lu dans la variable d'environnement `env` (jamais sa valeur ici), absent => ERREUR du watchdog. pending : flux declare, affiche [EN ATTENTE], jamais controle ni alerte ; retirer la cle quand la sonde existe.",
  "flows": [
    {
      "id": "db-backups",
      "label": "db-backups, copie distante",
      "type": "github-commits",
      "repo": "thonyAGP/db-backups",
      "branch": "main",
      "messagePattern": "^chore\\(dumps\\): backup",
      "thresholdHours": 26
    },
    {
      "id": "fincascout-routine",
      "label": "FincaScout, routine quotidienne",
      "type": "github-file-date",
      "repo": "thonyAGP/FincaScout",
      "branch": "main",
      "path": "docs/JOURNAL.md",
      "dateRegex": "## (\\d{4}-\\d{2}-\\d{2})",
      "thresholdHours": 30
    },
    {
      "id": "devops-factory-workflows",
      "label": "DevOps-Factory, workflows chroniques",
      "type": "github-workflow-runs",
      "repo": "thonyAGP/DevOps-Factory",
      "branch": "master",
      "workflows": [
        "renovate.yml",
        "ai-branding-guard.yml",
        "factory-ci.yml"
      ],
      "consecutiveRunFailures": 3
    },
    {
      "id": "boxmail-server",
      "label": "Boxmail, serveur",
      "type": "https",
      "url": "https://boxmail.lb2i.com/health",
      "expectStatus": 200,
      "expectJson": {
        "status": "ok"
      },
      "consecutiveFailures": 2
    },
    {
      "id": "casasync-pulse",
      "label": "CasaSync, crons",
      "type": "https",
      "url": "https://app-casasync.vercel.app/api/health/pulse",
      "expectStatus": 200,
      "expectJson": {
        "status": "ok"
      },
      "auth": {
        "header": "x-cron-secret",
        "env": "CASASYNC_CRON_SECRET"
      },
      "consecutiveFailures": 2,
      "pending": true,
      "pendingReason": "sonde GET /api/health/pulse à créer dans CasaSync après CHG-345 : lecture seule du heartbeat scenarios-tick"
    },
    {
      "id": "lb2i-pulse",
      "label": "LB2I, application",
      "type": "https",
      "url": "https://app.lb2i.com/api/health/pulse",
      "expectStatus": 200,
      "expectJson": {
        "status": "ok"
      },
      "auth": {
        "header": "Authorization",
        "env": "LB2I_CRON_SECRET",
        "prefix": "Bearer "
      },
      "consecutiveFailures": 2,
      "pending": true,
      "pendingReason": "sonde GET /api/health/pulse à créer dans LB2I : SELECT 1 derrière requireCronAuth"
    },
    {
      "id": "rappels-api",
      "label": "Rappels, API publique",
      "type": "https",
      "url": "https://rappels.lb2i.com/v1/reminders",
      "expectStatus": 401,
      "consecutiveFailures": 2
    }
  ]
}
